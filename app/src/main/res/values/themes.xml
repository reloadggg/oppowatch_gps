<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KartLapSE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowSwipeToDismiss">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@android:color/holo_green_light</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:colorControlHighlight">@android:color/holo_green_light</item>
        <item name="android:colorControlActivated">@android:color/holo_green_light</item>
    </style>
</resources>
